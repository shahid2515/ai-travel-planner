# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in what you have.
# The app runs with NO keys at all (bundled demo itinerary), and
# fully on the free tier with just GEMINI_API_KEY.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres, e.g. Neon — free tier, no card) ----
# Pooled endpoint — what the app uses. Serverless opens many short-lived
# connections and Postgres runs out without a pooler.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct endpoint — migrations need a real session the pooler cannot give.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── The model ───────────────────────────────────────────────
# Pick ONE. Gemini is free and needs no credit card; OpenAI needs billing.
# If both are set, OpenAI wins — override with LLM_PROVIDER=gemini.

# Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned on purpose: free-tier quota is per model, and "-latest" aliases track
# the newest model, which has the smallest allowance (20 requests).
GEMINI_MODEL=gemini-3.5-flash
# Trips of 6+ days produce enough output to overrun a 60s serverless request on
# the model above, so they use this faster one instead.
GEMINI_MODEL_LONG=gemini-3.5-flash-lite

# Paid: https://platform.openai.com/api-keys  (needs billing credit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force a provider when both keys are present: openai | gemini
LLM_PROVIDER=

# ─── Place lookup and maps ───────────────────────────────────
# Leave these empty and the app uses OpenStreetMap + Leaflet, which need
# no key and no billing account. You lose star ratings and review counts.
#
# With them, you get Google Places ratings, reviews and photos.
# https://console.cloud.google.com/google/maps-apis
# Server key: enable "Places API (New)". Restrict by IP.
GOOGLE_MAPS_API_KEY=
# Browser key: enable "Maps JavaScript API". Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID enables vector maps and custom styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Demo protection ------------------------------------------
# Generation limits, counted from the trips table. Defaults shown.
RATE_LIMIT_PER_VISITOR=5
RATE_LIMIT_GLOBAL_DAILY=40
