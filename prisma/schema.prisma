// Prisma schema — SQLite for local dev.
// To deploy (Vercel + Neon/Supabase): change provider to "postgresql",
// point DATABASE_URL at the hosted database, then run `npx prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id        String   @id @default(cuid())
  ownerId   String // anonymous browser session id (swap for a real user id when auth is added)

  title     String
  summary   String

  // Queryable trip facts, denormalised so the "Saved trips" list needs no JSON parsing
  city      String
  country   String
  lat       Float?
  lng       Float?
  startDate String? // ISO yyyy-mm-dd
  days      Int
  travelers Int
  budget    Int
  currency  String   @default("USD")
  pace      String   @default("balanced")
  heroPhoto String?

  // Full generated + Google-enriched payload (JSON string — SQLite has no native JSON type)
  data      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}
