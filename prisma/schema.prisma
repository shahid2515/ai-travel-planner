// Prisma schema — Postgres (Neon), used in both local dev and production.
//
// Two URLs on purpose:
//   DATABASE_URL  pooled endpoint. Serverless functions open a new connection
//                 per invocation and would exhaust Postgres without a pooler.
//   DIRECT_URL    direct endpoint. Migrations need a real session, which the
//                 pooler cannot give them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id        String   @id @default(cuid())
  ownerId   String // anonymous browser session id (swap for a real user id when auth is added)

  title     String
  summary   String

  // Queryable trip facts, denormalised so the "Saved trips" list needs no JSON parsing
  city      String
  country   String
  lat       Float?
  lng       Float?
  startDate String? // ISO yyyy-mm-dd
  days      Int
  travelers Int
  budget    Int
  currency  String   @default("USD")
  pace      String   @default("balanced")
  heroPhoto String?

  // Full generated + Google-enriched payload (JSON string — SQLite has no native JSON type)
  data      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}
